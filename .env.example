# Django
DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# Application security
VAULT_LOOKUP_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# PostgreSQL RDS
DB_NAME=filepad_db
DB_USER=filepad_user
DB_PASSWORD=replace-with-database-password
DB_HOST=your-rds-endpoint
DB_PORT=5432

# AWS S3
USE_S3=True
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=ap-south-1

# Prefer an EC2 IAM role for AWS permissions.
# Avoid putting AWS access keys in this file.
